{
  "expo": {
    "name": "Expenses",
    "slug": "expenses",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expenses",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nicklane123.expenses",
      "infoPlist": {
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "My Expenses"
          },
          {
            "INAlternativeAppName": "My Budget"
          },
          {
            "INAlternativeAppName": "My Spending"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#047857",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#047857",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#04241A"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "./plugins/with-weak-frameworks",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": ["native"]
      }
    },
    "description": "Personal expense tracker with quick natural-language entry, monthly budgets and insights."
  }
}
